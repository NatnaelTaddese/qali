{
  "expo": {
    "name": "qali",
    "slug": "qali",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qali",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myqali.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.myqali.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fcfcfc",
          "dark": {
            "backgroundColor": "#111111"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Lexend-Regular.ttf",
            "./assets/fonts/Lexend-Medium.ttf",
            "./assets/fonts/Lexend-SemiBold.ttf",
            "./assets/fonts/Lexend-Bold.ttf",
            "./assets/fonts/Fraunces-Medium.ttf",
            "./assets/fonts/Fraunces-Bold.ttf",
            "./assets/fonts/Fraunces-ExtraBold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Lexend",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Lexend-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Lexend-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Lexend-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Lexend-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Fraunces",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Fraunces-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Fraunces-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Fraunces-ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
